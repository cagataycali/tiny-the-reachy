[Unit]
Description=TINY (Reachy Mini) — docker compose stack (voice + telegram + thinker)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/tiny-the-reachy
# .env auto-loaded by docker compose; build-if-needed for a clean fresh checkout
ExecStart=/usr/bin/docker compose up --build -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=900
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
