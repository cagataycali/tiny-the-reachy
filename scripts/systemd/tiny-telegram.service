[Unit]
Description=TINY (Reachy Mini) — Telegram listener (multi-turn agent + voice control)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tiny-the-reachy
EnvironmentFile=-%h/tiny-the-reachy/.env
Environment=REACHY_CONNECTION_MODE=auto
ExecStart=%h/tiny-the-reachy/.venv/bin/python %h/tiny-the-reachy/telegram_listener.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
