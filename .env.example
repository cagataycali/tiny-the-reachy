# Copy to .env (gitignored) and fill in your secrets.
# docker compose auto-loads this file when it sits next to docker-compose.yml.

# --- AWS Bedrock — REPL/telegram/thinker agents (Claude Opus) -----------
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=us-west-2
# TINY_MODEL_ID=global.anthropic.claude-opus-4-8

# --- OpenAI Realtime (default voice provider for the bidi voice persona) -
OPENAI_API_KEY=
# VOICE_PROVIDER=openai        # openai | nova_sonic | gemini
# VOICE_NAME=alloy             # alloy/ash/ballad/coral/echo/sage/shimmer/verse
# VOICE_MODEL=gpt-realtime     # openai only
# VOICE_RESTART_DELAY=5

# --- Gemini Live (alternative voice provider) ---------------------------
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- Reachy Mini daemon wiring ------------------------------------------
# Lite (USB to laptop):  daemon runs on localhost:8000 (auto works)
# Wireless (CM4):        daemon runs on the robot; reach it at reachy-mini.local:8000
REACHY_HOST=reachy-mini.local
REACHY_PORT=8000
REACHY_CONNECTION_MODE=auto     # auto | localhost_only | network
# REACHY_USE_SIM=1              # run against MuJoCo simulation (no hardware)
# REACHY_MEDIA_BACKEND=no_media # no_media | local | webrtc (daemon owns cam by default)
# REACHY_CAMERA_BACKEND=local   # backend used transiently for frame grabs
# TINY_CAMERA_SNAPSHOT=/tmp/tiny_view.jpg

# --- TTS (reachy_say) ---------------------------------------------------
# TINY_TTS_SPACE=ResembleAI/Chatterbox-Multilingual-TTS
# TINY_TTS_REF_AUDIO=            # URL or path to a reference voice for cloning

# --- Telegram bot — multi-turn agent + /mute /unmute /state /wake -------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=cagataycali   # comma-separated usernames or numeric IDs
# TELEGRAM_DEFAULT_CHAT_ID=            # thinker heartbeat destination
# TELEGRAM_HISTORY_LIMIT=20

# --- Thinker loop -------------------------------------------------------
# THINKER_INTERVAL=30
# THINKER_DISABLED=1

# --- DevDuck (imported by dispatch tool) --------------------------------
DEVDUCK_AUTO_START_SERVERS=false
DEVDUCK_AMBIENT_MODE=false
BYPASS_TOOL_CONSENT=true
